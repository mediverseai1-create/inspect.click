# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI Inspection Assistant (server-side only). If unset, the Assistant
# renders as "Coming soon" instead of a fake response.
AI_PROVIDER_API_KEY=

# Payment links for paid plans (e.g. Stripe Payment Links).
# If unset, upgrade buttons route to sign-up instead of a broken checkout.
STARTER_PAYMENT_LINK=
PRO_PAYMENT_LINK=
SCALE_PAYMENT_LINK=

# Base URL of the deployed app, used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
